{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "TES Site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "5500",
        "."
      ],
      "port": 5500
    },
    {
      "name": "TES Site (any port)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "."
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Geo map (static publish)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5616",
        "--directory",
        "C:/dev/cleveland-geo-visualizer/publish"
      ],
      "port": 5616
    },
    {
      "name": "Admin console (dev Worker)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/tes-portal/scripts/dev-console.mjs"
      ],
      "port": 5590
    },
    {
      "name": "3D Shed (vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/3D Shed/node_modules/vite/bin/vite.js",
        "C:/dev/3D Shed",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}