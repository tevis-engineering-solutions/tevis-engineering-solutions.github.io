{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "TES Site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "5500",
        "."
      ],
      "port": 5500
    },
    {
      "name": "TES Site (any port)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "."
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "TES Site (python)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5618"
      ],
      "port": 5618
    },
    {
      "name": "Geo map (static publish)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5616",
        "--directory",
        "C:/dev/cleveland-geo-visualizer/publish"
      ],
      "port": 5616
    },
    {
      "name": "Admin console (dev Worker)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/tes-portal/scripts/dev-console.mjs"
      ],
      "port": 5590
    },
    {
      "name": "Site + dev Worker (5594)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/tes-portal/scripts/dev-console.mjs",
        "--port",
        "5594"
      ],
      "port": 5594
    },
    {
      "name": "Site + dev Worker, trial plans (5595)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/tes-portal/scripts/dev-console.mjs",
        "--port",
        "5595",
        "--plan-ids",
        "{\"website-watch:site:monthly\":\"P-DEV-M\",\"website-watch:site:annual\":\"P-DEV-A\",\"website-watch:site:monthly:trial\":\"P-DEV-MT\",\"website-watch:site:annual:trial\":\"P-DEV-AT\"}"
      ],
      "port": 5595
    },
    {
      "name": "Admin console (slice 6)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/worktrees/tes-portal-slice6/scripts/dev-console.mjs",
        "--port",
        "5593",
        "--site",
        "C:/dev/worktrees/website-slice6"
      ],
      "port": 5593
    },
    {
      "name": "Admin console (sourcing branch)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/worktrees/tes-portal-sourcing/scripts/dev-console.mjs",
        "--port",
        "5592",
        "--site",
        "C:/dev/worktrees/website-sourcing"
      ],
      "port": 5592
    },
    {
      "name": "3D Shed (vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "C:/dev/3D Shed/node_modules/vite/bin/vite.js",
        "C:/dev/3D Shed",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
